{
    "name": "hrm/portal",
    "description": "Internal HR payroll lookup portal",
    "type": "project",
    "require": {},
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Shuchkin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "smoke-test": "php scripts/smoke_test.php",
        "test": "phpunit --configuration phpunit.xml",
        "maintenance": "php scripts/maintenance.php",
        "bench-local-read": "php scripts/benchmark_local_read.php",
        "check": [
            "@smoke-test",
            "@test"
        ]
    }
}
